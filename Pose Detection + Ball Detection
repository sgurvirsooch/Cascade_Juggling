frame_number = 0

total_ball_detections = 0


try:

    while True:

        success, frame = cap.read()

        if not success:
            break

        time_seconds = frame_number / fps

        # ====================================================
        # YOLO BODY POSE
        # ====================================================

        pose_results = pose_model.predict(
            source=frame,
            verbose=False
        )

        pose_result = pose_results[0]

        # Draw body skeleton
        annotated_frame = pose_result.plot()

        # Extract body keypoints
        if (
            pose_result.keypoints is not None
            and pose_result.keypoints.xy is not None
        ):

            keypoints_xy = (
                pose_result.keypoints.xy
                .cpu()
                .numpy()
            )

            keypoints_conf = None

            if pose_result.keypoints.conf is not None:

                keypoints_conf = (
                    pose_result.keypoints.conf
                    .cpu()
                    .numpy()
                )

            for person_id, person_points in enumerate(
                keypoints_xy
            ):

                for keypoint_id, point in enumerate(
                    person_points
                ):

                    x = float(point[0])
                    y = float(point[1])

                    confidence = None

                    if keypoints_conf is not None:

                        confidence = float(
                            keypoints_conf[person_id][keypoint_id]
                        )

                    body_data.append({
                        "frame": frame_number,
                        "time_seconds": time_seconds,
                        "person_id": person_id,
                        "keypoint_id": keypoint_id,
                        "keypoint_name": BODY_NAMES[keypoint_id],
                        "x": x,
                        "y": y,
                        "confidence": confidence
                    })

        detections = detect_balls(frame)

        # Sort detected balls from left to right
        detections = sorted(
            detections,
            key=lambda d: (
                d["box"][0] + d["box"][2]
            ) / 2
        )

        for detection_id, detection in enumerate(
            detections
        ):

            box = detection["box"]

            x1 = float(box[0])
            y1 = float(box[1])
            x2 = float(box[2])
            y2 = float(box[3])

            confidence = detection["confidence"]

            center_x = (x1 + x2) / 2
            center_y = (y1 + y2) / 2

            box_width = x2 - x1
            box_height = y2 - y1

            total_ball_detections += 1


            ball_data.append({
                "frame": frame_number,
                "time_seconds": time_seconds,
                "detection_id": detection_id,
                "center_x": center_x,
                "center_y": center_y,
                "x1": x1,
                "y1": y1,
                "x2": x2,
                "y2": y2,
                "box_width": box_width,
                "box_height": box_height,
                "confidence": confidence,
                "detection_source": detection["source"]
            })


            cv2.rectangle(
                annotated_frame,
                (int(x1), int(y1)),
                (int(x2), int(y2)),
                (0, 0, 255),
                2
            )

            # Draw centre point
            cv2.circle(
                annotated_frame,
                (int(center_x), int(center_y)),
                5,
                (0, 0, 255),
                -1
            )

            # Ball label
            label = (
                f"Ball {detection_id + 1} "
                f"{confidence:.2f}"
            )

            cv2.putText(
                annotated_frame,
                label,
                (int(x1), max(20, int(y1) - 10)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (0, 0, 255),
                2
            )


        cv2.putText(
            annotated_frame,
            f"Frame: {frame_number}",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated_frame,
            f"Time: {time_seconds:.2f}s",
            (20, 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated_frame,
            f"Balls detected: {len(detections)}",
            (20, 105),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (0, 255, 255),
            2
        )



        writer.write(annotated_frame)


        if SHOW_VIDEO:

            cv2.imshow(
                "YOLO Pose + Ball Detection",
                annotated_frame
            )

        frame_number += 1


        if frame_number % 30 == 0:

            print(
                f"Processed {frame_number}/{total_frames} "
                f"frames | "
                f"{frame_number / fps:.1f}s | "
                f"Total ball detections: "
                f"{total_ball_detections}"
            )

        # Press Q to stop early
        if SHOW_VIDEO:

            if cv2.waitKey(1) & 0xFF == ord("q"):
                print("Stopped early by user.")
                break

finally:


