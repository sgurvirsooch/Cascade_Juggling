def enhance_frame(frame):

    # Improve local contrast
    lab = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2LAB
    )

    l, a, b = cv2.split(lab)

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    enhanced_l = clahe.apply(l)

    enhanced_lab = cv2.merge(
        (enhanced_l, a, b)
    )

    enhanced = cv2.cvtColor(
        enhanced_lab,
        cv2.COLOR_LAB2BGR
    )

    return enhanced


def calculate_iou(box_a, box_b):

    x1 = max(box_a[0], box_b[0])
    y1 = max(box_a[1], box_b[1])

    x2 = min(box_a[2], box_b[2])
    y2 = min(box_a[3], box_b[3])

    intersection_width = max(0, x2 - x1)
    intersection_height = max(0, y2 - y1)

    intersection = (
        intersection_width * intersection_height
    )

    area_a = max(
        0,
        (box_a[2] - box_a[0]) *
        (box_a[3] - box_a[1])
    )

    area_b = max(
        0,
        (box_b[2] - box_b[0]) *
        (box_b[3] - box_b[1])
    )

    union = area_a + area_b - intersection

    if union <= 0:
        return 0.0

    return intersection / union


def extract_ball_detections(result, pass_name):

    detections = []

    if result.boxes is None:
        return detections

    if len(result.boxes) == 0:
        return detections

    boxes = result.boxes.xyxy.cpu().numpy()
    confidences = result.boxes.conf.cpu().numpy()

    for box, confidence in zip(boxes, confidences):

        detections.append({
            "box": [
                float(box[0]),
                float(box[1]),
                float(box[2]),
                float(box[3])
            ],
            "confidence": float(confidence),
            "source": pass_name
        })

    return detections

def merge_detections(detections):

    # Keep higher-confidence detections first
    detections = sorted(
        detections,
        key=lambda d: d["confidence"],
        reverse=True
    )

    kept = []

    for detection in detections:

        duplicate = False

        for existing in kept:

            overlap = calculate_iou(
                detection["box"],
                existing["box"]
            )

            if overlap >= MERGE_IOU:
                duplicate = True
                break

        if not duplicate:
            kept.append(detection)

    return kept


def detect_balls(frame):

    all_detections = []

    # PASS 1: Original frame
    original_results = ball_model.predict(
        source=frame,
        classes=[BALL_CLASS_ID],
        conf=BALL_CONFIDENCE,
        imgsz=BALL_IMAGE_SIZE,
        iou=BALL_IOU,
        max_det=BALL_MAX_DET,
        verbose=False
    )

    all_detections.extend(
        extract_ball_detections(
            original_results[0],
            "original"
        )
    )

    # PASS 2: Contrast-enhanced frame
    if USE_ENHANCED_PASS:

        enhanced_frame = enhance_frame(frame)

        enhanced_results = ball_model.predict(
            source=enhanced_frame,
            classes=[BALL_CLASS_ID],
            conf=BALL_CONFIDENCE,
            imgsz=BALL_IMAGE_SIZE,
            iou=BALL_IOU,
            max_det=BALL_MAX_DET,
            verbose=False
        )

        all_detections.extend(
            extract_ball_detections(
                enhanced_results[0],
                "enhanced"
            )
        )

    # Merge overlapping boxes
    merged = merge_detections(
        all_detections
    )

    return merged


